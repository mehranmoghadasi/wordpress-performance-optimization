# WordPress performance + hardening — Apache 2.4 (.htaccess)
# Requires: mod_rewrite, mod_deflate, mod_expires, mod_headers. Each block is skipped if its module is absent.
# Put this in the WordPress root. If a caching plugin manages .htaccess, merge rather than overwrite.

# --- WordPress rewrite rules (unchanged from core) ---------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^index\.php$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /index.php [L]
</IfModule>

# --- Compression -------------------------------------------------------------------------------------------
# Brotli when mod_brotli is loaded, gzip otherwise. Fonts in woff/woff2 and images are already compressed.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json application/xml
    AddOutputFilterByType BROTLI_COMPRESS application/xhtml+xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml application/rss+xml image/svg+xml font/ttf font/otf
    <IfModule mod_setenvif.c>
        SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|zip|gz|br|7z|mp4|mp3|ogg|woff2?)$ no-gzip
    </IfModule>
</IfModule>

# --- Browser caching (Expires) -------------------------------------------------------------------------------
# HTML is never cached here: WordPress / your caching plugin decide that per response.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault                          "access plus 1 month"
    ExpiresByType text/html                 "access plus 0 seconds"
    ExpiresByType application/json          "access plus 0 seconds"
    ExpiresByType application/xml           "access plus 0 seconds"
    ExpiresByType text/xml                  "access plus 0 seconds"
    ExpiresByType text/css                  "access plus 1 year"
    ExpiresByType application/javascript    "access plus 1 year"
    ExpiresByType text/javascript           "access plus 1 year"
    ExpiresByType image/jpeg                "access plus 1 year"
    ExpiresByType image/png                 "access plus 1 year"
    ExpiresByType image/gif                 "access plus 1 year"
    ExpiresByType image/webp                "access plus 1 year"
    ExpiresByType image/avif                "access plus 1 year"
    ExpiresByType image/svg+xml             "access plus 1 year"
    ExpiresByType image/x-icon              "access plus 1 year"
    ExpiresByType font/ttf                  "access plus 1 year"
    ExpiresByType font/otf                  "access plus 1 year"
    ExpiresByType font/woff                 "access plus 1 year"
    ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Versioned assets (WordPress appends ?ver=) can be immutable.
    <FilesMatch "\.(css|js|woff2?|ttf|otf|svg|png|jpe?g|gif|webp|avif)$">
        Header append Cache-Control "public, immutable"
    </FilesMatch>

    # Fonts and CSS may be requested cross-origin from a CDN host.
    <FilesMatch "\.(ttf|otf|woff2?|css)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Note the syntax: no colon after "Vary".
    Header append Vary "Accept-Encoding"

    # Security headers (X-XSS-Protection is deprecated and omitted on purpose).
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# --- Hardening -----------------------------------------------------------------------------------------------
Options -Indexes

# xmlrpc.php is intentionally NOT blocked here: Jetpack and the mobile apps need it. The mu-plugin disables
# it via the xmlrpc_enabled filter instead; add it to the list below only if you are sure nothing uses it.
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|readme\.html|license\.txt)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
